		"clean": "rm -rf dist"
	},
	"license": "MIT",
	"dependencies": {
		"dotenv": "^16.4.0",
		"ethers": "^6.9.0",
		"winston": "^3.11.0"
	},
	"devDependencies": {
		"@types/jest": "^29.5.0",
		"@types/node": "^20.10.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.4.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
