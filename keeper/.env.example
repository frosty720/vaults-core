# vault-reprice-keeper — copy to .env and fill in.
# See ../docs/REPRICE_KEEPER_HANDOFF.md for the incident/design context.

# RPC + chain
RPC_URL=https://rpc.kalychain.io/rpc
CHAIN_ID=3888

# Keeper wallet — MUST hold OPERATOR_ROLE on VAULT_MANAGER, and a little KLC for gas.
# Prefer a dedicated keeper wallet (grant it OPERATOR_ROLE) over reusing the admin/deployer key
# so the admin key never touches a server. See README "Key handling".
KEEPER_PK=

# Deployed VaultManager (printed by scripts/deploy-v2-stack.ts). Mainnet: 0x8ad3ad4a3f20672d39f6f87d6bdf1df5386ac6a5
VAULT_MANAGER=

# Optional: override the stable/pool set this keeper watches. JSON array of
# {"symbol","address","decimals","pool"}. Leave unset to use the built-in mainnet
# default (USDT + KUSD against their VaultManager-configured V3 pools).
# STABLES_JSON=

# Polling + smoothing
CHECK_INTERVAL_MS=60000        # how often to sample pool spot, per stable
SAMPLE_WINDOW=15               # samples kept for the median (15 * 60s = 15min rolling window)
REPRICE_THRESHOLD_BPS=500      # 5% median drift -> send setReferencePrice
ALERT_THRESHOLD_BPS=1000       # 10% drift -> alert (independent of whether a reprice also fires)
MIN_REPRICE_INTERVAL_MS=600000 # 10min rate limit between reprices per stable (bypassed when purchases are actively blocked)
GAS_LIMIT=200000               # KalyChain's eth_estimateGas intermittently 500s; always send explicit

# Safety
DRY_RUN=false                  # true = compute + log intended actions, never send transactions

# Alerts (optional) — generic JSON POST to any webhook (Slack/Discord-compatible incoming
# webhook, or your own endpoint). Leave blank to rely on console + logs/ only.
ALERT_WEBHOOK_URL=

LOG_LEVEL=info
