# ── RPC endpoints ──────────────────────────────────────────────────────────
KALY_MAINNET_RPC=https://rpc.kalychain.io/rpc
KALY_TESTNET_RPC=https://testnetrpc.kalychain.io/rpc

# ── Signing keys (NEVER commit a real key) ───────────────────────────────────
# DEPLOYER_PK = account[0] on the testnet/mainnet network. For the audit-fix upgrade
# it deploys the new implementations AND drives the Governor (propose/vote/queue/execute),
# so it must hold the gKLC voting power (the deployer self-delegated for Phase-2).
DEPLOYER_PK=
# OPERATOR_PK = account[1]. Only needed for scripts/configure.ts (operator-gated setters).
# NOT needed for scripts/upgrade-audit.ts — that rescales referencePrice atomically inside
# the governance proposal, so no separate operator tx is required.
OPERATOR_PK=

# ── Audit-fix upgrade target addresses (scripts/upgrade-audit.ts) ────────────
# Testnet (3889) values are baked into the script as defaults; set these only to override
# (e.g. for a mainnet run, point them at the mainnet proxies/Governor/Timelock + stables).
VAULT_MANAGER=0xd97A80404990f6a734901e691D13385728A55A1D
REWARDS_POOL=0x36c908DA0DDEE1620F4fD2b97c9259F863ae41F8
GOVERNOR=0x92177A348367D0122e043448e7f308ba989CFb3F
TIMELOCK=0xAd338da8A2dDE5B5Fe08362c379c66D18Bb24151
# 6-decimal stables whose referencePrice must be rescaled by the H-1 fix:
USDT=0x6Fdb0fEd277b878a0d80494b06EA054C99d2fdD2
USDC=0x148d19609F3Ad595F8455225510f89cF0F121013
# Decimals-independent reference price (WKLC 1e18 per 1.0 stable). 416666666666666666666 == KLC @ $0.0024.
NEW_REF_PRICE=416666666666666666666

# ── Misc ─────────────────────────────────────────────────────────────────────
# Set FORK=1 to run the mainnet-fork tests (test/fork/*).
# FORK=1
