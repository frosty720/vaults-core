# ── KalyChain MAINNET (3888) deploy env — copy to .env and fill the TODOs ──
# NOTE: all ADDRESSES, STABLES, TIERS and bounds now live in ONE place: scripts/deploy.config.ts
# (the 3888 block). This file is ONLY secrets + the few deploy-time values. Do NOT commit a filled .env.

# --- keys / RPC ---
DEPLOYER_PK=            # TODO: deployer key (temp admin+operator during deploy; hands off to Timelock via phase2.sh)
KALY_MAINNET_RPC=https://rpc.kalychain.io/rpc

# --- deploy-time overrides (config has sensible defaults; set to be explicit) ---
# maxTotalWeight caps total reward WEIGHT (Σ priceUSD*aprBps), NOT reserve $. A single Whale = 1.4B,
# so keep it generous (>= 1.4B) or large tiers revert 'VM: cap exceeded'. 1e12 = effectively uncapped.
# The RESERVE (KLC) is the real funding limit; degraded mode is the graceful overflow.
MAX_TOTAL_WEIGHT=1000000000000
# MAX_WEIGHT_CEILING=10000000000000   # optional; defaults to 10x maxTotalWeight
KEEPER_ADDRESS=         # TODO: NEW dedicated keeper EOA (gets OPERATOR_ROLE). NOT deployer/admin/dev wallet.
METADATA_CID=           # TODO: ipfs folder CID from upload-nft-metadata.sh; tier i -> ipfs://<CID>/i.json

# --- NFT upload (company thirdweb account; for scripts/upload-nft-metadata.sh only) ---
THIRDWEB_SECRET_KEY=    # TODO: company thirdweb secret key (never commit)

# --- filled AFTER deploy (for scripts/fund-reserve.ts — boss funds the reserve) ---
VAULT_MANAGER=          # printed by deploy-v2-stack.ts
REWARDS_POOL=           # printed by deploy-v2-stack.ts
RESERVE_KLC=10000000    # boss funds 10M KLC via fund-reserve.ts (Phase D); top up as it sells through
